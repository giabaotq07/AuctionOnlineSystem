<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.AuctionController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="ghost-button" text="Trở về trang chủ" />
            <Label styleClass="screen-title" text="Tạo phiên đấu giá mới" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="content-shell">
                    <VBox maxWidth="860.0" spacing="18.0" styleClass="card">
                        <padding>
                            <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="status-pill" text="SELLER" />
                            <Label styleClass="section-title" text="Thông tin tài sản đấu giá" />
                        </HBox>
                        <Separator />

                        <GridPane hgap="18.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="210.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label styleClass="field-label" text="Tên tài sản *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="nameField" promptText="Nhập tên tài sản..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label styleClass="field-label" text="Mô tả chi tiết" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="TOP" />
                            <TextArea fx:id="descriptionField" prefRowCount="4" promptText="Nhập mô tả tình trạng, thông tin..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label styleClass="field-label" text="Phân loại *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <ComboBox fx:id="typeComboBox" prefWidth="320.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label styleClass="field-label" text="Giá khởi điểm (USD) *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="startingPriceField" promptText="VD: 5000000" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label styleClass="field-label" text="Bước giá tối thiểu (USD) *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <TextField fx:id="stepPriceField" promptText="VD: 100000" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                            <Label styleClass="field-label" text="Ngày bắt đầu *" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <DatePicker fx:id="startDatePicker" promptText="Chọn ngày" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                            <Label styleClass="field-label" text="Giờ bắt đầu (HH:mm) *" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <TextField fx:id="startTimeField" promptText="VD: 14:30" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                            <Label styleClass="field-label" text="Ngày kết thúc *" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                            <DatePicker fx:id="endDatePicker" promptText="Chọn ngày" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                            <Label styleClass="field-label" text="Giờ kết thúc (HH:mm) *" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                            <TextField fx:id="endTimeField" promptText="VD: 15:30" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                            <Label styleClass="field-label" text="Ảnh vật phẩm" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="9">
                                <Button fx:id="chooseImageButton" mnemonicParsing="false" onAction="#handleChooseImage" styleClass="secondary-button" text="Chọn ảnh..." />
                                <Label fx:id="imageFileNameLabel" styleClass="muted-label" text="Chưa chọn ảnh" />
                            </HBox>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Hủy bỏ" />
                            <Button mnemonicParsing="false" onAction="#handleAdd" text="BẮT ĐẦU PHIÊN ĐẤU GIÁ" />
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
