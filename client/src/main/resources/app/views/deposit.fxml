<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0f1424;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.DepositController">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #11182d;">
      <padding>
        <Insets bottom="12.0" left="40.0" right="40.0" top="12.0" />
      </padding>
      <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #4f46e5; -fx-font-weight: bold;" text="&lt; TRỞ VỀ TRANG CHỦ" />
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="NẠP TIỀN" textFill="WHITE" />
    </HBox>
  </top>
  <center>
    <VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: #0f1424;">
      <Label fx:id="totalBalanceLabel" style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;" text="Tổng số dư: 0 đ" />
      <Label fx:id="availableBalanceLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" text="Số dư khả dụng: 0 đ" />
      <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;" text="Nhập số tiền cần nạp" />
      <TextField fx:id="depositAmountField" prefWidth="220.0" promptText="Nhập số tiền..." style="-fx-background-color: #11182d; -fx-text-fill: white; -fx-border-color: #2d3748; -fx-border-radius: 8; -fx-background-radius: 8;" />
      <Button onAction="#handleDeposit" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Nạp tiền" />
    </VBox>
  </center>
</BorderPane>
