<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.DepositController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="ghost-button" text="Trở về trang chủ" />
            <Label styleClass="screen-title" text="Ví của tôi" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0" styleClass="content-shell">
            <VBox maxWidth="480.0" spacing="16.0" styleClass="wallet-card">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>
                <Label styleClass="section-title" text="Nạp tiền vào ví" />
                <VBox spacing="8.0" styleClass="panel-soft">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label fx:id="totalBalanceLabel" styleClass="price-label" text="Tổng số dư: ---" />
                    <Label fx:id="availableBalanceLabel" styleClass="muted-label" text="Khả dụng: ---" />
                </VBox>
                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="Số tiền cần nạp" />
                    <TextField fx:id="depositAmountField" prefWidth="260.0" promptText="Nhập số tiền..." />
                </VBox>
                <Button maxWidth="Infinity" onAction="#handleDeposit" prefHeight="44.0" text="NẠP TIỀN" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
