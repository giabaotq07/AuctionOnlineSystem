<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.AllAuctionController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Button onAction="#switchToUi" styleClass="ghost-button" text="Trở về trang chủ" />
            <Label styleClass="screen-title" text="Tất cả phiên đấu giá" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleReload" styleClass="secondary-button" text="Làm mới" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="24.0" styleClass="content-shell">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-card">
                        <padding>
                            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                        </padding>
                        <Label styleClass="field-label" text="Bộ lọc" />
                        <ComboBox fx:id="typeFilterComboBox" prefWidth="190.0" promptText="Chọn loại item" />
                        <TextField fx:id="searchField" prefWidth="320.0" promptText="Tìm theo tên phiên đấu giá..." />
                    </HBox>

                    <VBox spacing="14.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="status-pill" text="ĐANG MỞ" />
                            <Label styleClass="section-title" text="Sắp / đang diễn ra" />
                        </HBox>
                        <FlowPane fx:id="runningPane" hgap="18.0" maxWidth="Infinity" vgap="18.0" />
                    </VBox>

                    <VBox spacing="14.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="warning-pill" text="KẾT THÚC" />
                            <Label styleClass="section-title" text="Đã kết thúc" />
                        </HBox>
                        <FlowPane fx:id="finishedPane" hgap="18.0" maxWidth="Infinity" vgap="18.0" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
