<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" styleClass="auth-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.LoginController">
    <children>
        <StackPane prefWidth="420.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="TOP_LEFT" maxHeight="-Infinity" prefWidth="420.0" spacing="18.0" styleClass="auth-card">
                    <children>
                        <Label styleClass="brand-mark" text="LoPPy" />
                        <Label styleClass="auth-title" text="Chào mừng trở lại!" />
                        <Label styleClass="muted-label" text="Đăng nhập để tiếp tục đấu giá" />

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="Email hoặc tên đăng nhập" />
                            <TextField fx:id="account" promptText="Nhập email hoặc tên đăng nhập" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="Mật khẩu" />
                            <PasswordField fx:id="password" promptText="Nhập mật khẩu" />
                        </VBox>

                        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="46.0" text="ĐĂNG NHẬP" />

                        <HBox alignment="CENTER" spacing="6.0">
                            <Label styleClass="muted-label" text="Bạn chưa có tài khoản?" />
                            <Label fx:id="lblRegister" onMouseClicked="#switchToRegister" styleClass="link-label" text="Đăng ký ngay" />
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
