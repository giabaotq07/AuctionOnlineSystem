<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="app-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.FirstScene">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Label styleClass="screen-title" text="Danh sách phiên đấu giá" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefWidth="330.0" promptText="Tìm kiếm tài sản đấu giá..." />
            <Button onAction="#handleReload" styleClass="secondary-button" text="Làm mới" />
            <Button fx:id="btnAuth" onAction="#handleAuth" styleClass="ghost-button" text="Đăng nhập / Đăng ký" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="238.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets bottom="22.0" left="18.0" right="18.0" top="22.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="brand-mark" text="LoPPy" />
            </HBox>
            <Label styleClass="brand-subtitle" text="Đấu giá mọi lúc, mọi nơi" />
            <Separator />
            <Button maxWidth="Infinity" prefHeight="40.0" styleClass="sidebar-button-active" text="Trang chủ" />
            <Button maxWidth="Infinity" onAction="#switchToMine" prefHeight="40.0" styleClass="sidebar-button" text="Đấu giá của tôi" />
            <Button maxWidth="Infinity" onAction="#switchToAll" prefHeight="40.0" styleClass="sidebar-button" text="Tất cả đấu giá" />
            <Button maxWidth="Infinity" onAction="#switchToMess" prefHeight="40.0" styleClass="sidebar-button" text="Phòng chat" />
            <Button maxWidth="Infinity" onAction="#switchToOrganize" prefHeight="40.0" styleClass="sidebar-button" text="Tạo phiên đấu giá" />
            <Button maxWidth="Infinity" onAction="#switchToDeposit" prefHeight="40.0" styleClass="sidebar-button" text="Ví của tôi" />
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="6.0" styleClass="panel-soft">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <Label styleClass="meta-label" text="Số dư khả dụng" />
                <Label fx:id="balanceLabel" styleClass="price-label" text="---" />
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="24.0" styleClass="content-shell">
                    <StackPane prefHeight="190.0" styleClass="hero-panel">
                        <VBox alignment="CENTER_LEFT" maxWidth="760.0" spacing="10.0">
                            <padding>
                                <Insets left="34.0" right="34.0" />
                            </padding>
                            <Label styleClass="warning-pill" text="LIVE AUCTION" />
                            <Label styleClass="section-title-large" text="Theo dõi phiên đấu giá nổi bật trong thời gian thực" wrapText="true" />
                            <Label styleClass="muted-label" text="Duyệt tài sản sắp diễn ra, đang mở và đã hoàn tất với bố cục gọn, rõ và dễ thao tác." wrapText="true" />
                        </VBox>
                    </StackPane>

                    <VBox spacing="12.0">
                        <Label styleClass="section-title" text="Tài sản sắp đấu giá" />
                        <StackPane fx:id="upcomingAuctionsPane" minHeight="270.0" styleClass="panel-card" />
                    </VBox>

                    <VBox spacing="12.0">
                        <Label styleClass="section-title" text="Tài sản đang đấu giá" />
                        <StackPane fx:id="activeAuctionsPane" minHeight="270.0" styleClass="panel-card" />
                    </VBox>

                    <VBox spacing="12.0">
                        <Label styleClass="section-title" text="Tài sản đã đấu giá" />
                        <StackPane fx:id="completedAuctionsPane" minHeight="270.0" styleClass="panel-card" />
                    </VBox>

                    <ListView fx:id="auctionListView" managed="false" visible="false" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
