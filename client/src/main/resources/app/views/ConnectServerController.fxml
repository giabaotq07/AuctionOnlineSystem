<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" styleClass="auth-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.ConnectServerController">
    <children>

        <VBox alignment="TOP_LEFT" prefWidth="420.0" spacing="18.0" styleClass="auth-card" AnchorPane.bottomAnchor="118.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="118.0">
            <children>
                <Label styleClass="auth-title" text="Kết nối Server" />
                <Label styleClass="muted-label" text="Vui lòng kết nối tới server để tiếp tục" wrapText="true" />
                <Button fx:id="connectButton" maxWidth="Infinity" onAction="#connectServer" prefHeight="48.0" text="KẾT NỐI" />
                <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="muted-label" text="Đang chờ kết nối..." wrapText="true" />
            </children>
        </VBox>
    </children>
</AnchorPane>
