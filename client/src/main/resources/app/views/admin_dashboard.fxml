<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.AdminDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="16.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Label styleClass="brand-mark" text="LoPPy" />
            <Separator orientation="VERTICAL" prefHeight="38.0" />
            <Label styleClass="screen-title" text="Hệ thống quản trị" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" styleClass="muted-label" text="Admin: Administrator" />
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="danger-button" text="Đăng xuất" />
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Quản lý phiên đấu giá">
                <HBox spacing="20.0" styleClass="content-shell">
                    <VBox maxWidth="Infinity" spacing="14.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-card">
                            <padding>
                                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
                            </padding>
                            <TextField fx:id="auctionSearchField" promptText="Tìm kiếm phiên đấu giá..." HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="typeFilterComboBox" prefWidth="160.0" />
                            <Button mnemonicParsing="false" onAction="#handleRefreshAuctions" styleClass="secondary-button" text="Làm mới" />
                        </HBox>
                        <TableView fx:id="auctionTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colAuctionId" prefWidth="60.0" text="Mã" />
                                <TableColumn fx:id="colItemName" prefWidth="180.0" text="Tên vật phẩm" />
                                <TableColumn fx:id="colItemType" prefWidth="90.0" text="Phân loại" />
                                <TableColumn fx:id="colStartingPrice" prefWidth="110.0" text="Giá khởi điểm" />
                                <TableColumn fx:id="colHighestBid" prefWidth="110.0" text="Giá hiện tại" />
                                <TableColumn fx:id="colStartTime" prefWidth="130.0" text="Bắt đầu" />
                                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Trạng thái" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox minWidth="430.0" prefWidth="500.0" spacing="14.0" styleClass="card" HBox.hgrow="NEVER">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <Label styleClass="section-title" text="Thông tin phiên đấu giá" />
                        <Separator />

                        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="14.0">
                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="Tên tài sản *" />
                                        <TextField fx:id="nameField" promptText="Nhập tên tài sản..." />
                                    </VBox>
                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="Mô tả chi tiết" />
                                        <TextArea fx:id="descriptionField" prefHeight="82.0" promptText="Mô tả tình trạng vật phẩm..." wrapText="true" />
                                    </VBox>
                                    <HBox spacing="12.0">
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Phân loại *" />
                                            <ComboBox fx:id="typeComboBox" maxWidth="Infinity" />
                                        </VBox>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Thời lượng (phút) *" />
                                            <TextField fx:id="durationField" promptText="VD: 60" />
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="12.0">
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Giá khởi điểm ($) *" />
                                            <TextField fx:id="startingPriceField" promptText="VD: 1000000" />
                                        </VBox>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Bước giá tối thiểu ($) *" />
                                            <TextField fx:id="stepPriceField" promptText="VD: 50000" />
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="12.0">
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Ngày bắt đầu *" />
                                            <DatePicker fx:id="startDatePicker" maxWidth="Infinity" />
                                        </VBox>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="field-label" text="Giờ bắt đầu (HH:mm) *" />
                                            <TextField fx:id="startTimeField" promptText="VD: 14:30" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <Separator />
                        <VBox alignment="CENTER" spacing="10.0">
                            <HBox alignment="CENTER" spacing="10.0">
                                <Button mnemonicParsing="false" onAction="#handleClearForm" styleClass="secondary-button" text="Xóa form" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#handleCreateAuction" text="Thêm mới" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="10.0">
                                <Button mnemonicParsing="false" onAction="#handleUpdateAuction" styleClass="success-button" text="Cập nhật" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#handleCancelAuction" styleClass="danger-button" text="Hủy phiên" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>

            <Tab text="Quản lý người dùng">
                <VBox spacing="14.0" styleClass="content-shell">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-card">
                        <padding>
                            <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
                        </padding>
                        <TextField fx:id="userSearchField" promptText="Tìm kiếm khách hàng theo tên hoặc tài khoản..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleRefreshUsers" styleClass="secondary-button" text="Làm mới danh sách" />
                    </HBox>
                    <TableView fx:id="userTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUserId" prefWidth="80.0" text="Mã KH" />
                            <TableColumn fx:id="colUserName" prefWidth="250.0" text="Họ tên" />
                            <TableColumn fx:id="colUserAccount" prefWidth="250.0" text="Tên tài khoản" />
                            <TableColumn fx:id="colUserBalance" prefWidth="250.0" text="Số dư khả dụng ($)" />
                            <TableColumn fx:id="colUserRole" prefWidth="180.0" text="Vai trò" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
