<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.MessController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Button onAction="#switchToUi" styleClass="ghost-button" text="Trở về trang chủ" />
            <Label styleClass="screen-title" text="Phòng chat chung" />
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" styleClass="content-shell">
            <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="chat-window" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="chatBox" spacing="14.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
            <HBox alignment="CENTER" spacing="12.0" styleClass="chat-composer">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <TextArea fx:id="myTextArea" prefHeight="54.0" promptText="Nhập tin nhắn... (Dùng @ để tag sản phẩm)" wrapText="true" HBox.hgrow="ALWAYS" />
                <Button onAction="#send" prefHeight="50.0" prefWidth="110.0" text="GỬI" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
