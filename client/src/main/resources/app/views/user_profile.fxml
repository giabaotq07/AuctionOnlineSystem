<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" styleClass="screen-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.client.controllers.UserProfileController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="14.0" styleClass="top-bar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="ghost-button" text="Trở về trang chủ" />
            <Label styleClass="screen-title" text="Hồ sơ người dùng" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" styleClass="danger-button" text="Đăng xuất" />
        </HBox>

        <VBox alignment="TOP_CENTER" spacing="22.0" styleClass="profile-card" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="112.0">
            <padding>
                <Insets bottom="34.0" left="40.0" right="40.0" top="34.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="34.0" styleClass="panel-soft">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                </padding>
                <VBox alignment="CENTER" spacing="12.0">
                    <StackPane prefHeight="142.0" prefWidth="142.0">
                        <Circle fx:id="avatarCircle" fill="#5146f2" radius="70.0" stroke="#8b82ff" strokeWidth="2.0" />
                        <Label fx:id="avatarLabel" style="-fx-font-size: 54px; -fx-font-weight: 900; -fx-text-fill: white;" text="A" />
                        <ImageView fx:id="avatarImageView" fitHeight="140.0" fitWidth="140.0" managed="false" preserveRatio="false" smooth="true" visible="false" />
                    </StackPane>
                    <Button onAction="#handleChangeAvatar" prefWidth="150.0" styleClass="secondary-button" text="Đổi Avatar" />
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="userNameLabel" styleClass="section-title-large" text="Tên Người Dùng" />
                    <Label fx:id="emailLabel" styleClass="muted-label" text="example@email.com" />
                    <Label fx:id="idLabel" styleClass="meta-label" text="ID: #12345" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="22.0">
                <VBox spacing="8.0" styleClass="panel-soft" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="22.0" left="24.0" right="24.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-label" text="VAI TRÒ" />
                    <Label fx:id="roleLabel" styleClass="section-title" text="Người Đấu Giá" />
                </VBox>
                <VBox spacing="8.0" styleClass="panel-soft" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="22.0" left="24.0" right="24.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-label" text="SỐ DƯ" />
                    <Label fx:id="walletLabel" styleClass="price-label" text="---" />
                </VBox>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
