<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.LoginController">
    <children>
        <VBox maxHeight="Infinity" maxWidth="500.0" minHeight="0.0" minWidth="408.0" prefHeight="438.0" prefWidth="408.0" style="-fx-background-color: rgba(30, 24, 10, 0.82);              -fx-background-radius: 24;              -fx-padding: 48;              -fx-effect: dropshadow(three-pass-box, rgba(80,60,20,0.7), 30, 0, 0, 0);              -fx-border-color: #e6c27a;              -fx-border-width: 3;              -fx-border-radius: 24;" AnchorPane.bottomAnchor="60.0" AnchorPane.rightAnchor="60.0">

            <children>

                <HBox alignment="TOP_RIGHT">
                    <Label style="-fx-font-size: 24px;                           -fx-font-weight: bold;                           -fx-cursor: hand;                           -fx-text-fill: #e6c27a;" text="X" />
                </HBox>

                   <Label style="-fx-font-size: 36px;                       -fx-font-weight: bold;                       -fx-text-fill: #e6c27a;                       -fx-effect: dropshadow(gaussian, #fffbe6, 10, 0.5, 0, 0);                       -fx-font-family: 'Times New Roman', 'Serif';" text="VẠN BẢO CÁC" />

                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #e6c27a;" text="Bạn chưa có tài khoản? " />
                    <Label fx:id="lblRegister" onMouseClicked="#switchToRegister" style="-fx-font-size: 16px;                           -fx-font-weight: bold;                           -fx-text-fill: #7ed6df;                           -fx-cursor: hand;                           -fx-underline: true;" text="Đăng Ký Ngay" />
                </HBox>

                <!-- USERNAME -->
                <VBox fillWidth="true" spacing="10.0">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #e6c27a;" text="Tên đăng nhập / Email" />
                    <TextField fx:id="account" maxWidth="Infinity" promptText="Nhập tên đăng nhập/Email" style="-fx-font-size: 14px;                               -fx-padding: 15;                               -fx-background-color: #fffbe6;                               -fx-text-fill: #3d2c0a;                               -fx-border-color: #e6c27a;                               -fx-border-radius: 8;                               -fx-background-radius: 8;" />
                </VBox>

                <!-- PASSWORD -->
                <VBox fillWidth="true" spacing="10.0">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #e6c27a;" text="Mật khẩu" />
                    <PasswordField fx:id="password" maxWidth="Infinity" promptText="Mật khẩu" style="-fx-font-size: 14px;                                   -fx-padding: 15;                                   -fx-background-color: #fffbe6;                                   -fx-text-fill: #3d2c0a;                                   -fx-border-color: #e6c27a;                                   -fx-border-radius: 8;                                   -fx-background-radius: 8;" />
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 14px;                           -fx-font-weight: bold;                           -fx-text-fill: #7ed6df;                           -fx-underline: true;                           -fx-cursor: hand;" text="Quên mật khẩu?" />
                </HBox>

                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="50.0" style="-fx-background-color: linear-gradient(to bottom, #e6c27a, #bfa14a);                        -fx-text-fill: #3d2c0a;                        -fx-font-size: 20px;                        -fx-font-weight: bold;                        -fx-background-radius: 12;                        -fx-cursor: hand;                        -fx-effect: dropshadow(gaussian, #fffbe6, 10, 0.5, 0, 0);" text="ĐĂNG NHẬP" />

            </children>
        </VBox>
    </children>
</AnchorPane>
