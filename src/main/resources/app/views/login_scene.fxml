<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0a0b10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.LoginController">
    <children>
        <VBox alignment="CENTER" layoutX="390.0" layoutY="110.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #161b26; -fx-background-radius: 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0, 0, 0);">
            <children>
                <HBox alignment="TOP_RIGHT" prefWidth="200.0">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;" text="X" textFill="#2563eb" />
                </HBox>

                <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="VẠN BẢO CÁC" textFill="WHITE" />

                <HBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #9ca3af;" text="Bạn chưa có tài khoản? " />
                    <Label fx:id="lblRegister" onMouseClicked="#switchToRegister" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-cursor: hand;" text="Đăng Ký Ngay" />
                </HBox>

                <VBox prefWidth="420.0" spacing="10.0">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" text="Tên đăng nhập / Email" />
                    <TextField fx:id="account" promptText="Nhập tên đăng nhập/Email" style="-fx-font-size: 14px; -fx-padding: 15; -fx-background-color: #0f121a; -fx-text-fill: white; -fx-border-color: #2d3748; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </VBox>

                <VBox prefWidth="420.0" spacing="10.0">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" text="Mật khẩu" />
                    <PasswordField fx:id="password" promptText="Mật khẩu" style="-fx-font-size: 14px; -fx-padding: 15; -fx-background-color: #0f121a; -fx-text-fill: white; -fx-border-color: #2d3748; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </VBox>

                <HBox alignment="CENTER_LEFT" prefWidth="420.0">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3b82f6; -fx-underline: false; -fx-cursor: hand;" text="Quên mật khẩu?" />
                </HBox>

                <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="50.0" prefWidth="420.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="ĐĂNG NHẬP">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
