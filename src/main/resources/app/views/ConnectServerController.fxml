<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.ConnectServerController">
    <children>
        <VBox alignment="CENTER" layoutX="390.0" layoutY="210.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">
            <children>
                <Label text="LOPPY AUCTION" textFill="#673ab7" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Label text="KẾT NỐI TỚI SERVER" textFill="#333333" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <Button fx:id="connectButton" mnemonicParsing="false" onAction="#ConnectServer" prefHeight="50.0" prefWidth="420.0" text="KẾT NỐI SERVER" style="-fx-background-color: #673ab7; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>

                <Label fx:id="statusLabel" text="Đang chờ kết nối..." style="-fx-font-size: 16px; -fx-text-fill: #666666;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
