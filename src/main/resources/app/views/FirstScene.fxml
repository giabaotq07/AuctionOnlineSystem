<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.FirstScene"
            stylesheets="@style.css">

   <!-- CENTER: SEARCH + LIST -->
   <center>
      <VBox alignment="CENTER"
            spacing="15"
            style="-fx-padding: 20;">

         <TextField fx:id="searchField"
                    promptText="Search session..."
                    prefWidth="350"
                    style="-fx-font-size: 14px; -fx-padding: 8;"/>

         <ListView fx:id="sessionListView"
                   prefWidth="350"
                   prefHeight="250"
                   style="-fx-border-radius: 8;"/>
         <TextArea fx:id="detailArea"
                   prefWidth="350"
                   prefHeight="300"
                   editable="false"
                   wrapText="true"/>
      </VBox>
   </center>

   <!-- BOTTOM: BUTTONS -->
   <bottom>
      <HBox alignment="CENTER"
            spacing="40"
            style="-fx-padding: 20;">

         <Button text="My History"
                 onAction="#SwitchToOrganize"
                 prefWidth="160" prefHeight="45"/>

         <Button text="Add Item"
                 onAction="#SwitchToMine"
                 prefWidth="160" prefHeight="45"/>

         <Button text="Bid Item"
                 onAction="#SwitchToLive"
                 prefWidth="160" prefHeight="45"/>

      </HBox>
   </bottom>

</BorderPane>