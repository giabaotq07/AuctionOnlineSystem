<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.UIController"
            stylesheets="@style.css">

   <children>

      <!-- CENTER BUTTON GROUP -->
      <HBox alignment="CENTER"
            spacing="40"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <children>

            <Button text="My History"
                    onAction="#SwitchToOrganize"
                    prefWidth="160" prefHeight="45"/>

            <Button text="Add Item"
                    onAction="#SwitchToMine"
                    prefWidth="160" prefHeight="45"/>

            <Button text="Bid Item"
                    onAction="#SwitchToLive"
                    prefWidth="160" prefHeight="45"/>

         </children>
      </HBox>

   </children>
</AnchorPane>