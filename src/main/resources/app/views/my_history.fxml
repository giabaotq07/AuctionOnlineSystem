<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #0f1424;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.MyHistoryController">

    <!-- ================= TOP ================= -->
    <top>
        <VBox style="-fx-background-color: #11182d;">
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0"
                  style="-fx-background-color: #11182d;">
                <padding>
                    <Insets left="40.0" right="40.0"/>
                </padding>

                <Label text="LOPPY AUCTION"
                       style="-fx-font-weight: bold; -fx-font-size: 24px;"
                       textFill="#673ab7"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Back"
                        onAction="#SwitchToUI"
                        style="-fx-background-color: #673ab7;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;
                               -fx-padding: 5 15;"/>
            </HBox>
        </VBox>
    </top>
    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="20.0"
              style="-fx-background-color: #0f1424;">

            <padding>
                <Insets top="20" left="40" right="40" bottom="20"/>
            </padding>

            <Label text="LỊCH SỬ ĐẤU GIÁ"
                   style="-fx-font-weight: bold; -fx-font-size: 22px;"
                   textFill="#673ab7"/>

            <!-- ================= HORIZONTAL SCROLL AREA ================= -->
            <ScrollPane fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;
                               -fx-border-color: transparent;">

                <content>
                    <HBox fx:id="historyContainerPane"
                          spacing="20"
                          alignment="CENTER_LEFT"
                          style="-fx-background-color: #0f1424;">

                        <padding>
                            <Insets top="10" left="10" right="10" bottom="10"/>
                        </padding>

                    </HBox>
                </content>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>