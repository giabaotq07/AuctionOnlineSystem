<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #0f1424;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.DepositController">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #11182d;">
      <padding>
        <Insets left="40.0" right="40.0" top="12.0" bottom="12.0" />
      </padding>
      <Button text="&lt; TRỞ VỀ" onAction="#handleBack"
              style="-fx-background-color: transparent; -fx-text-fill: #4f46e5; -fx-font-weight: bold;" />
      <Label text="NẠP TIỀN" style="-fx-font-size: 22px; -fx-font-weight: bold;" textFill="WHITE" />
    </HBox>
  </top>
  <center>
    <VBox spacing="12.0" alignment="CENTER" style="-fx-background-color: #0f1424;">
      <Label fx:id="totalBalanceLabel"
             text="Tổng số dư: 0 đ"
             style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;" />
      <Label fx:id="availableBalanceLabel"
             text="Số dư khả dụng: 0 đ"
             style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" />
      <Label text="Nhập số tiền cần nạp" style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;" />
      <TextField fx:id="depositAmountField" promptText="Nhập số tiền..."
                 prefWidth="220.0"
                 style="-fx-background-color: #11182d; -fx-text-fill: white; -fx-border-color: #2d3748; -fx-border-radius: 8; -fx-background-radius: 8;" />
      <Button text="Nạp tiền" onAction="#handleDeposit" prefWidth="200.0" prefHeight="40.0"
              style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />
    </VBox>
  </center>
</BorderPane>
