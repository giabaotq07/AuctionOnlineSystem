<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.LiveController">
    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: white;">
            <!-- Header section -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-border-color: #eaeaea; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets left="40.0" right="40.0" />
                </padding>
                <Button mnemonicParsing="false" onAction="#SwitchToUI" style="-fx-background-color: transparent; -fx-text-fill: #673ab7; -fx-font-weight: bold; -fx-font-size: 16px;" text="&lt; TRỞ VỀ TRANG CHỦ" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="CHI TIẾT TÀI SẢN ĐẤU GIÁ" textFill="#673ab7" style="-fx-font-weight: bold; -fx-font-size: 24px;" />
            </HBox>
        </VBox>
    </top>

    <!-- Center content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <padding>
                <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
            </padding>
            <HBox spacing="30.0">
                <!-- Image Side -->
                <VBox prefWidth="500.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-padding: 20;">
                    <StackPane prefHeight="350.0" style="-fx-background-color: #eaeaea; -fx-background-radius: 5;">
                        <Label text="HÌNH ẢNH TÀI SẢN" style="-fx-text-fill: #999999; -fx-font-size: 20px;" />
                    </StackPane>
                </VBox>

                <!-- Information Side -->
                <VBox HBox.hgrow="ALWAYS" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-padding: 20;">
                    <Label fx:id="itemNameLabel" text="Tên tài sản đấu giá..." wrapText="true" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

                    <GridPane vgap="15.0" hgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Giá khởi điểm:" style="-fx-text-fill: #333333;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <Label fx:id="startPriceLabel" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111111;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Bước giá:" style="-fx-text-fill: #333333;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <Label fx:id="stepPriceLabel" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111111;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="Tiền đặt trước:" style="-fx-text-fill: #333333;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <Label fx:id="depositLabel" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #111111;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <Label text="Thời gian còn lại:" style="-fx-text-fill: #333333;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <Label fx:id="timeLabel" text="Đang tính toán..." style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #b91c1c;" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    </GridPane>

                    <Separator />

                    <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-padding: 20; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
                        <Label text="GIÁ HIỆN TẠI" style="-fx-font-size: 16px; -fx-text-fill: #666666;" />
                        <Label fx:id="currentPriceLabel" text="0 đ" textFill="#673ab7" style="-fx-font-size: 32px; -fx-font-weight: bold;" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <TextField fx:id="bidAmountField" promptText="Nhập mức giá..." prefWidth="250.0" prefHeight="40.0" style="-fx-font-size: 16px;" />
                            <Button text="TRẢ GIÁ" onAction="#handlePlaceBid" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #673ab7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 5;" />
                        </HBox>
                        <Label text="Khách hàng trả giá cao nhất sẽ giành quyền mua tài sản" style="-fx-font-size: 12px; -fx-text-fill: #999999;" />
                    </VBox>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>

