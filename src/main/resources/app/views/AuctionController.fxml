<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="455.0" prefWidth="914.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.AuctionController">

    <children>
        <Button layoutX="14.0" layoutY="415.0" onAction="#handleBack" text="Back" />
        <!-- LIST SESSION -->
        <ListView fx:id="sessionListView" layoutX="450" layoutY="40" prefHeight="300" prefWidth="300" />

        <!-- FORM -->
        <VBox layoutX="14.0" layoutY="22.0" spacing="10">

            <Label text="Add Item" />
            <TextField fx:id="nameField" promptText="Tên" />
            <TextField fx:id="descriptionField" promptText="Miêu Tả" />
            <TextField fx:id="priceField" promptText="Giá" />
            <TextField fx:id="minutesField" promptText="Số phút" />

            <Button onAction="#handleAdd" text="Add" />

            <TextArea fx:id="outputArea" prefHeight="0.0" prefWidth="400" />

        </VBox>

    </children>
</AnchorPane>
