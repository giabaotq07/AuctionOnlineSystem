<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.UIController">
   <children>
      <HBox alignment="CENTER" layoutY="394.0" prefHeight="326.0" prefWidth="1280.0" spacing="300.0">
         <children>
            <Button mnemonicParsing="false" onAction="#SwitchToOrganize" prefHeight="50.0" prefWidth="130.0" text="Hold an Auction" />
            <Button mnemonicParsing="false" onAction="#SwitchToMine" prefHeight="50.0" prefWidth="130.0" text="My Auction" />
            <Button mnemonicParsing="false" onAction="#SwitchToLive" prefHeight="50.0" prefWidth="130.0" text="Live Auction" />
         </children>
      </HBox>
      <MenuBar layoutY="1.0" prefHeight="25.0" prefWidth="1280.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </children>
</AnchorPane>
