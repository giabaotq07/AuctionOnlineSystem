<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0a0b10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.FirstScene">

    <top>
        <VBox style="-fx-background-color: #161b26;">
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-border-color: #eaeaea; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets left="40.0" right="40.0" />
                </padding>
                <Label style="-fx-font-weight: bold; -fx-font-size: 24px;" text="LOPPY AUCTION" textFill="WHITE" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField accessibleText="col" prefWidth="300.0" promptText="Tìm kiếm tài sản đấu giá..." style="-fx-background-radius: 20; -fx-padding: 5 15; -fx-border-radius: 20; -fx-border-color: blue;" />
                <Button style="-fx-background-color: #673ab7; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 5 15;" text="Tìm kiếm" />
                <Region prefWidth="20.0" HBox.hgrow="SOMETIMES" />
                <Button fx:id="btnAuth" onAction="#handleAuth" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-weight: bold;" text="Đăng nhập / Đăng ký" />
            </HBox>
        </VBox>
    </top>
    <left>
        <VBox prefHeight="660.0" prefWidth="202.0" spacing="8.0" style="-fx-background-color: #161b26; -fx-border-color: #1a2236; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets left="15.0" right="15.0" top="20.0" />
            </padding>

            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: #2d5cf7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12;" text="🏠  TRANG CHỦ" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#SwitchToLive" style="-fx-background-color: transparent; -fx-text-fill: #8a9bbf; -fx-padding: 12;" text="💎  TÀI SẢN ĐẤU GIÁ" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#SwitchToMine" style="-fx-background-color: transparent; -fx-text-fill: #8a9bbf; -fx-padding: 12;" text="📈  ĐẤU GIÁ CỦA TÔI" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#SwitchToMess" style="-fx-background-color: transparent; -fx-text-fill: #8a9bbf; -fx-padding: 12;" text="💬  MESS CHAT" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#SwitchToOrganize" style="-fx-background-color: transparent; -fx-text-fill: #8a9bbf; -fx-padding: 12;" text="➕  TẠO PHIÊN" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20.0">
                <padding>
                    <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
                </padding>

                <StackPane prefHeight="200.0" style="-fx-background-color: #0a0b10; -fx-background-radius: 10;">
                    <Label style="-fx-font-size: 24px;" text="BANNER QUẢNG CÁO" textFill="#999999" />
                </StackPane>

                <Label style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-padding: 10 0 0 0;" text="TÀI SẢN ĐANG ĐẤU GIÁ" textFill="WHITE" />

                <StackPane fx:id="activeAuctionsPane" prefHeight="320.0" style="-fx-background-color: #0a0b10;" />

                <Label style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-padding: 20 0 0 0;" text="TÀI SẢN ĐÃ ĐẤU GIÁ" textFill="WHITE" />

                <FlowPane hgap="20.0" vgap="20.0">
                    <VBox prefWidth="280.0" style="-fx-background-color: #f9f9f9; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-padding: 15; -fx-spacing: 10;">
                        <StackPane prefHeight="150.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 5;"><Label style="-fx-text-fill: #aaa;" text="Ảnh tài sản 3" /></StackPane>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #333;" text="Đồng hồ Rolex Datejust" wrapText="true" />
                        <Label style="-fx-text-fill: #673ab7; -fx-font-weight: bold;" text="Giá trúng thầu: 250.000.000 đ" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Kết thúc: 01/10/2026 10:00" />
                        <Button disable="true" maxWidth="Infinity" style="-fx-background-color: #999999; -fx-text-fill: white; -fx-background-radius: 4;" text="Đã bán" />
                    </VBox>
                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
