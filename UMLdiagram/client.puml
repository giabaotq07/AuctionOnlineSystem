@startuml
' Module: client
skinparam classAttributeIconSize 0
skinparam shadowing false

package "app.client.core" {
  class Client <<Singleton>> {
    - instance : Client
    - socket : Socket
    - out : ObjectOutputStream
    - in : ObjectInputStream
    - listeners : Map<ResponseType, List<PacketListener>>
    - commands : EnumMap<ResponseType, Command>
    + getInstance() : Client
    + connect(host, port)
    + sendRequest(packet)
    + subscribe(type, listener)
    + unsubscribe(type, listener)
    - notifyListeners(packet)
    - handlePacket(packet)
  }
}

package "app.client.manager" {
  class NavigationManager <<Singleton>> {
    - instance : NavigationManager
    - primaryStage : Stage
    - currentController : Object
    + getInstance() : NavigationManager
    + navigateTo(view : View)
    + setStage(stage)
    + getCurrentController()
  }

  class ClientRequestService <<Facade>> {
    - client : Client
    + login(req)
    + register(req)
    + placeBid(req)
    + createAuction(req)
    + setAutoBid(req)
    + deposit(req)
    + fetchAuctionSummaries()
  }

  class UserManager <<Singleton>> {
    - currentUser : User
    - walletBalance : BigDecimal
    + setCurrentUser(user)
    + getCurrentUser() : User
    + updateBalance(amount)
  }

  class ClientNotificationCenter {
    - client : Client
    + registerWalletListener()
    + registerAuctionUpdateListener()
    + unregisterAll()
  }

  class AuctionDetailProxy <<Proxy>> {
    - auctionId : Long
    - preview : AuctionPreview
    - fullDetail : Auction
    + getPreview() : AuctionPreview
    + loadFullDetail(callback)
    + invalidateCache()
  }
}

package "app.client.command" {
  interface Command {
    + execute(packet : PacketRes)
  }

  class UpdateAuctionCommand
  class PlaceBidResultCommand
  class LoginResultCommand
  class AuctionSummariesCommand
  class ChatResultCommand
  class WalletUpdateCommand
}

package "app.client.store" {
  class DataStore <<Singleton>> {
    - currentUser : User
    - auctionPreviews : List<AuctionPreview>
    - watchingAuctionId : Long
    + getInstance() : DataStore
    + setCurrentUser(user)
    + updatePreviews(list)
    + getWatchingId() : Long
  }

  class LiveAuctionSessionStore <<Singleton>> {
    - proxy : AuctionDetailProxy
    - currentBids : List<Bid>
    - chatMessages : List<ChatMsg>
    + getInstance()
    + setProxy(proxy)
    + addBid(bid)
    + clearSession()
  }
}

package "app.client.controllers" {
  interface Cleanable {
    + cleanup()
  }

  class LoginController
  class RegisterController
  class FirstScene
  class LiveController
  class AllAuctionController
  class AuctionController
  class DepositController
  class MessController
  class MyHistoryController
  class UserProfileController
  class SellerDashboardController
  class AdminDashboardController
  class ConnectServerController
}

package "app.client.enums" {
  enum View {
    CONNECT
    LOGIN
    REGISTER
    FIRST_SCENE
    LIVE
    AUCTION_FORM
    DEPOSIT
    PROFILE
    SELLER_DASH
    ADMIN_DASH
  }
}

package "app.common.observer" {
  interface PacketListener<T> {
    + onPacket(packet : T)
  }
}

' Relationships
Client ..> ClientRequestService
ClientRequestService --> Client : sends via
NavigationManager ..> View
Client ..> PacketListener : notifies
UpdateAuctionCommand ..|> Command
PlaceBidResultCommand ..|> Command
LoginResultCommand ..|> Command
AuctionSummariesCommand ..|> Command
ChatResultCommand ..|> Command
WalletUpdateCommand ..|> Command
Client ..> Command : dispatches
LiveController ..> LiveAuctionSessionStore
AuctionDetailProxy ..> LiveAuctionSessionStore
LoginController ..|> Cleanable
RegisterController ..|> Cleanable
FirstScene ..|> Cleanable
LiveController ..|> Cleanable
AllAuctionController ..|> Cleanable
AuctionController ..|> Cleanable
DepositController ..|> Cleanable
MessController ..|> Cleanable
MyHistoryController ..|> Cleanable
UserProfileController ..|> Cleanable
SellerDashboardController ..|> Cleanable
AdminDashboardController ..|> Cleanable
ConnectServerController ..|> Cleanable
AllAuctionController ..> ClientRequestService
FirstScene ..> DataStore

@enduml

